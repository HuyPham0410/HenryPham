<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">LET’S CONNECT</p><h1>Let's start a conversation.</h1><p class="intro">Have an entry-level opportunity, a project, or an idea to share? I’d love to hear from you.</p></section>
<div class="contact-grid">
  <%# Contact details come from the same CV-based profile used by the resume page. %>
  <section class="contact-info">
    <p class="eyebrow">A CONVERSATION IS A GOOD START</p><h2>Say hello.</h2>
    <p><%= profile.name %><br>Software engineering · Web development · AI/ML</p>
    <a class="email" href="mailto:<%= profile.email %>"><%= profile.email %> ↗</a>
    <p><a class="text-link" href="<%= profile.github %>" target="_blank" rel="noopener noreferrer">Find me on GitHub ↗</a></p>
    <p class="small">Messages sent through this form are stored privately on this website's server. Please don't include passwords or sensitive information.</p>
  </section>
  <section class="form-card"><h2>Send a message</h2>
    <% if (Object.keys(errors).length) { %><div class="notice error" role="alert">Please check the highlighted fields below.</div><% } %>
    <%# Keep server validation and the CSRF field: browser validation alone is not a security boundary. %>
    <form method="post" action="/contact">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% for (const [key, label, type, max] of [['name', 'Your name', 'text', 80], ['email', 'Email address', 'email', 254], ['message', 'Message', 'textarea', 3000]]) { %>
        <div class="field"><label for="<%= key %>"><%= label %></label>
          <% if (type === 'textarea') { %><textarea class="form-control" id="<%= key %>" name="<%= key %>" rows="6" required minlength="10" maxlength="<%= max %>" aria-invalid="<%= Boolean(errors[key]) %>" <% if (errors[key]) { %>aria-describedby="<%= key %>-error"<% } %>><%= values[key] || '' %></textarea>
          <% } else { %><input class="form-control" id="<%= key %>" name="<%= key %>" type="<%= type %>" autocomplete="<%= key %>" required <% if (key === 'name') { %>minlength="2"<% } %> maxlength="<%= max %>" value="<%= values[key] || '' %>" aria-invalid="<%= Boolean(errors[key]) %>" <% if (errors[key]) { %>aria-describedby="<%= key %>-error"<% } %>> <% } %>
          <% if (errors[key]) { %><p class="field-error" id="<%= key %>-error"><%= errors[key] %></p><% } %>
        </div>
      <% } %>
      <button class="button" type="submit">Send message ↗</button>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>
