<%- include('../partials/header') %>
<%# Bootstrap provides the responsive grid; decorative blobs are CSS-only and hidden from assistive technology. %>
<section class="hero row align-items-center g-5">
  <div class="col-lg-7 hero-copy">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> COMPUTER SCIENCE GRADUATE · CLASS OF 2026</p>
    <p class="hello">Hello, I'm Huy. You can call me Henry.</p>
    <h1>Thoughtful code.<br><span>Practical solutions.</span></h1>
    <p class="intro"><%= profile.summary %></p>
    <div class="actions"><a class="button" href="/work">Explore my work <span>↗</span></a><a class="button button-outline" href="<%= profile.cv %>" download>Download CV ↓</a></div>
    <p class="hero-note">SOFTWARE ENGINEERING &nbsp; / &nbsp; WEB &nbsp; / &nbsp; AI & ML</p>
  </div>
  <div class="col-lg-5">
    <figure class="portrait-scene">
      <span class="blob blob-outline" aria-hidden="true"></span>
      <div class="portrait-blob"><img src="/assets/images/portrait.jpg" alt="Huy Pham outdoors" width="640" height="800" fetchpriority="high"></div>
      <span class="orbit-dot" aria-hidden="true"></span>
      <figcaption><span>Huy (Henry) Pham</span><small>Curious mind. Hands-on builder.</small></figcaption>
      <span class="portrait-stamp" aria-hidden="true">HP<br>2026</span>
    </figure>
  </div>
</section>
<section class="credentials row g-0" aria-label="Education highlights">
  <div class="col-6 col-md-3"><small>EDUCATION</small><strong>UTSA</strong></div>
  <div class="col-6 col-md-3"><small>DEGREE</small><strong>B.S. Computer Science</strong></div>
  <div class="col-6 col-md-3"><small>GRADUATED</small><strong>May 2026</strong></div>
  <div class="col-6 col-md-3"><small>MAJOR GPA</small><strong>3.66 / 4.00</strong></div>
</section>
<section class="section-space row g-5">
  <div class="col-lg-4"><p class="eyebrow">01 / THE PERSON BEHIND THE CODE</p><h2>Always learning.<br>Intentionally building.</h2></div>
  <div class="col-lg-8 prose"><% for (const paragraph of profile.about) { %><p><%= paragraph %></p><% } %></div>
</section>
<section class="section-space">
  <div class="section-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2>From ideas to implementation.</h2></div><a class="text-link" href="/work">All projects ↗</a></div>
  <div class="row g-4">
    <% projects.slice(0, 2).forEach((project) => { %>
    <div class="col-md-6"><article class="project project-preview h-100">
      <p class="eyebrow"><%= project.category %></p><h3><%= project.title %></h3><p><%= project.description %></p>
      <ul class="tags"><% for (const tag of project.tags) { %><li><%= tag %></li><% } %></ul>
      <a class="text-link" href="/work">Explore project details ↗</a>
    </article></div>
    <% }) %>
  </div>
</section>
<section class="callout section-space"><div><p class="eyebrow">OPEN TO THE NEXT CHAPTER</p><h2>Let's build something meaningful.</h2></div><a class="button button-light" href="/contact">Get in touch ↗</a></section>
<%- include('../partials/footer') %>
