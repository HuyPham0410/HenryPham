PORT=3000
HOST=127.0.0.1
# Local binding only. Render automatically uses 0.0.0.0 and its provided PORT.
NODE_ENV=development
DATABASE_PATH=data/messages.sqlite
# Development can leave this empty. Production requires a random 64+ character secret.
CSRF_SECRET=
# Only set actual trusted reverse-proxy IPs/subnets when deploying.
TRUST_PROXY=
